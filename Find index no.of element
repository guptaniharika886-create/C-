#include <iostream>
using namespace std;

int main()
{
    int arr[5] = {12, 23, 45, 66, 78};

    cout << "update new array : ";

    for (int i = 1; i < 5; i++) {
        arr[i - 1] = arr[i];
        cout << arr[i] << " ";
    }

    cout << "\n";

    for (int i = 0; i < 4; i++) {
        cout << "the index is " << i
             << " value is : " << arr[i] << "\n";
    }

    return 0;
}
